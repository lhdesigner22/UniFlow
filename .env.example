# ── Backend (Render) ───────────────────────────────────────────────
# Segredo do JWT — string longa e aleatória
JWT_SECRET=troque-por-um-segredo-longo-aqui

# URL do frontend Vercel (sem barra no final)
CLIENT_URL=https://uni-flow.vercel.app

# Caminhos persistentes (volume do Render em /data)
DB_PATH=/data/uniflow.db
UPLOADS_PATH=/data/uploads

NODE_ENV=production
# PORT é definido automaticamente pelo Render

# ── Frontend (Vercel) ──────────────────────────────────────────────
# URL do backend Render (sem /api no final)
VITE_API_URL=https://uniflow-backend.onrender.com
