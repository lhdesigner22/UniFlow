# Segredo do JWT — use uma string longa e aleatória em produção
JWT_SECRET=troque-por-um-segredo-longo-aqui

# URL do frontend (em produção = mesma URL do servidor)
CLIENT_URL=https://seu-app.railway.app

# Caminhos persistentes (em produção aponta para o volume do Railway)
DB_PATH=/data/uniflow.db
UPLOADS_PATH=/data/uploads

# Node environment
NODE_ENV=production

# Porta (Railway define automaticamente)
# PORT=3001
